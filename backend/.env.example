# ===== 模型提供方 =====
# 始终启用真实 LLM。已有 backend/.env 时保留现有地址、模型和密钥，不要用示例覆盖。
MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
MODEL_API_KEY=replace-with-your-api-key
ALLOW_CLOUD_MODEL=true
#
# 切换为本地 Ollama 或其他 OpenAI 兼容服务（推荐，账单数据不出本机）：
#   MODEL_PROVIDER=openai_compatible
#   MODEL_BASE_URL=http://127.0.0.1:11434/v1
#   MODEL_NAME=qwen3:8b
#   MODEL_API_KEY=local
#   ALLOW_CLOUD_MODEL=false         # 本地模型无需确认
#
# 本地模型需先拉取：ollama pull qwen3:8b

# ===== 服务地址 / CORS =====
# 允许访问后端的前端来源，JSON 数组。前端换端口或部署到域名时必须同步修改。
# CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# ===== 运行限制 / 运行时治理 =====
MAX_STEPS=8
MAX_TOKENS=20000
MODEL_OUTPUT_TOKENS=1500
RUN_TIMEOUT_SECONDS=120          # 单次 run 墙钟上限：超时推友好 final，已完成步骤已落盘
TOOL_TIMEOUT_SECONDS=15          # 单次工具执行超时：超时转 TOOL_TIMEOUT 结构化错误回喂模型
APPROVAL_TTL_SECONDS=86400       # 审批有效期：过期后 resume 返回 410，需重新发起
MAX_TOOL_CALLS_PER_RUN=20        # 每次任务工具调用硬上限（成本护栏，跨审批续跑累计）
MODEL_RETRIES=2                  # 模型调用失败重试次数（指数退避）
RETRY_BACKOFF_SECONDS=0.5        # 重试基础退避秒数：0.5s → 1s → 2s
TOOL_RETRIES=2                   # 工具执行失败自动重试次数（指数退避；0=禁用）。
                                 # 只重试瞬时错误（超时/显式 retryable）；参数校验与业务失败不重试；
                                 # 重试复用同一 tool call id → 幂等键不变 → 写工具查重兜底不重复建卡

# ===== 上下文卫生 =====
# 工具结果回喂模型前的治理：截断/提炼护栏 + 查询结果缓存，防上下文爆炸。
CONTEXT_MAX_CHARS=2000           # 单条工具结果文本字符上限，超长截断并提示分页
CONTEXT_MAX_LINES=40             # 单条工具结果文本行数上限，超行保留前 N 行
TOOL_RESULT_CACHE_TTL=300        # 查询工具结果缓存秒数（query_bill/list_tracking_cards）；0=禁用

# ===== 以下配置当前未接线（历史遗留，保留仅为兼容）=====
# 四层混合意图路由（规则 → TF-IDF 小模型 → LLM → 澄清）已被 LLM tool-calling 取代，
# 相应模块已删除，以下配置在代码中无任何引用：
#   NLU_THRESHOLD / NLU_MARGIN / NLU_MIN_COVERAGE / ROUTING_TIMEOUT_SECONDS / PARAMETER_RETRIES
#
# 敏感词拦截：SENSITIVE_TERMS 已在 config.py 定义默认值，但尚未在任何环节接线——
# 命中这些词的请求目前不会被拦截。欢迎贡献（见 CONTRIBUTING.md）。
# SENSITIVE_TERMS=["密码","验证码","密钥","转账","付款","删除","清空","绕过","免确认"]
