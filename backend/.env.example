# ===== PersonalCopilot 环境变量模板 =====
# 用法：cp .env.example .env ，按需修改。
# 本机开发默认指向 127.0.0.1 的 PostgreSQL / Ollama。
# 【Windows 必读】localhost 会优先解析到 IPv6 ::1，而 Docker 只映射 IPv4，
# 所有连接串必须写 127.0.0.1，否则连不上 PG / Redis / Langfuse。

# ===== 对话模型（OpenAI 兼容） =====
MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=qwen3:8b
MODEL_API_KEY=local
ALLOW_CLOUD_MODEL=false
# 云端示例（对话与工具数据会离开本机，必须显式打开）：
#   MODEL_BASE_URL=https://api.deepseek.com/v1
#   MODEL_NAME=deepseek-v4-flash
#   MODEL_API_KEY=replace-with-your-api-key
#   ALLOW_CLOUD_MODEL=true
# 本地模型需先拉取：ollama pull qwen3:8b

# ===== 数据库：PostgreSQL 16 + pgvector =====
# 业务表、LangGraph checkpoint、知识库向量都在同一个 PG 实例。
DATABASE_URL=postgresql+asyncpg://postgres:123456@127.0.0.1:5432/PersonManager
# checkpoint 用 psycopg 方言，与业务库的 asyncpg 方言不同，故单独一项。
CHECKPOINT_URL=postgresql://postgres:123456@127.0.0.1:5432/PersonManager
# pytest fixture 专用库，每个用例重建全部表，避免污染开发库。
TEST_DATABASE_URL=postgresql+asyncpg://postgres:123456@127.0.0.1:5432/PersonManager_test
# 首次启动前执行 `alembic upgrade head`（建表 + vector 扩展 + HNSW 索引）；
# 测试库需先 CREATE EXTENSION IF NOT EXISTS vector。

# ===== Redis（可选） =====
# 留空 = 工具结果缓存退化成进程内内存缓存（单实例够用）。
# 多实例 / 多 worker 部署才需要共享缓存：REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# ===== 知识库 embedding（与对话模型相互独立） =====
# 默认本地 bge-m3，1024 维，与 knowledge_chunks.embedding 的维度一致，改模型需同步迁移。
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL_NAME=bge-m3
EMBEDDING_API_KEY=local
EMBEDDING_BATCH_SIZE=16
# 真实文档摄入的前置条件：ollama pull bge-m3（单测用 mock，不需要）。
CHUNK_SIZE=400                # 分块目标字符数
CHUNK_OVERLAP=50              # 相邻块重叠字符数

# ===== 访问鉴权 =====
# 账号密码体系：注册/登录签发 HMAC 签名令牌，数据按 user_id 隔离。
# 留空则首次启动自动生成密钥并落到 data/auth_secret，容器重启后令牌仍有效。
# 生产建议固定强随机值：python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# 前后端同源（vite /api 代理）时无需配置；换端口或上域名时填 JSON 数组：
# CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# ===== 结构化日志与 Langfuse 可观测性 =====
LOG_LEVEL=INFO                # 单行 JSON 日志级别
# 三个 LANGFUSE 凭证全部留空 = 追踪整体关闭，零网络请求、主流程不受影响。
# 配置后 trace（含模型输入输出）会发到 LANGFUSE_HOST，请确认隐私边界。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000
# 关联规则：每次请求的 request_id 即 trace_id；同一会话用
# langfuse_session_id（= thread_id）归组。响应头 X-Request-ID 可用来 grep 日志。

# ===== 运行时治理 =====
MAX_STEPS=8                   # 图执行步数上限
MAX_TOKENS=20000
MODEL_OUTPUT_TOKENS=1500
RUN_TIMEOUT_SECONDS=120       # 单次 run 墙钟上限：超时推友好 final，已完成步骤已落盘
TOOL_TIMEOUT_SECONDS=15       # 单次工具执行超时：转 TOOL_TIMEOUT 结构化错误回喂模型
APPROVAL_TTL_SECONDS=86400    # 审批有效期：过期后 resume 返回 410
MAX_TOOL_CALLS_PER_RUN=20     # 每次任务工具调用硬上限（跨审批续跑累计）
MODEL_RETRIES=2               # 模型调用失败重试次数（指数退避）
RETRY_BACKOFF_SECONDS=0.5
TOOL_RETRIES=2                # 工具瞬时错误重试次数（0=禁用）；复用同一 tool call id 保证幂等

# ===== 上下文治理 =====
CONTEXT_MAX_CHARS=2000        # 单条工具结果字符上限
CONTEXT_MAX_LINES=40          # 单条工具结果行数上限
TOOL_RESULT_CACHE_TTL=300     # 只读工具结果缓存秒数；0=禁用
HISTORY_WINDOW_SIZE=10        # 短期记忆滑动窗口保留的最近消息条数；0=关闭递进摘要
SUMMARY_MAX_CHARS=4000        # 单条对话摘要字符上限

# ===== 提示词安全 =====
# 已在 intent 节点接线：命中即走拒答路径，不注入业务 Skill、不调工具。
# SENSITIVE_TERMS=["密码","验证码","密钥","转账","付款","删除","清空","绕过","免确认"]

# ===== 已废弃配置（代码中无引用，不要填写） =====
# 四层混合意图路由已被 LLM tool-calling 取代：
#   NLU_THRESHOLD / NLU_MARGIN / NLU_MIN_COVERAGE / ROUTING_TIMEOUT_SECONDS / PARAMETER_RETRIES
# 旧访问令牌白名单已被账号密码体系取代：ACCESS_TOKENS
