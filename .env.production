# ============ PersonalCopilot 生产环境配置模板 ============
# 用法：cp .env.production .env ，填好下面带【必填】的项，然后 docker compose up -d --build
#
# 【重要】当前 docker-compose.yml 只编排 backend + frontend 两个服务，
#   **没有** PostgreSQL / Redis。上线前请自行准备 PG 16 + pgvector 与（可选）Redis，
#   并把它们接入同一 compose 网络；下面的主机要写容器名，不要写 127.0.0.1（那是容器内自己）。
#   详见 DEPLOY.md「方案一：第 1 步」与「存储前置」。

# ---------- 模型（云端 DeepSeek） ----------
# 【必填】你的 DeepSeek API Key（从本地 backend/.env 抄过来，别发到群里）
MODEL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash
# 云端模型会收到账单数据，必须显式打开
ALLOW_CLOUD_MODEL=true

# ---------- 存储层（必填） ----------
# PG 16 + pgvector：业务表、LangGraph checkpoint、知识库文本块与向量都在同一个库。
# Dockerfile 的 CMD 启动前会自动 alembic upgrade head（建表 + vector 扩展 + HNSW 索引）。
# 【必填】把 ChangeMe 换成真实密码；postgres 是容器名，需与你实际部署的 PG 服务名一致。
DATABASE_URL=postgresql+asyncpg://postgres:ChangeMe@postgres:5432/PersonManager
CHECKPOINT_URL=postgresql://postgres:ChangeMe@postgres:5432/PersonManager
# 可选：只读工具结果缓存。留空则退化成进程内内存缓存（单实例够用）。
# REDIS_URL=redis://redis:6379/0

# ---------- 知识库 embedding（可选，但上传文档需要） ----------
# 云端部署时本地 Ollama 不可达，需指向 backend 容器能访问的 OpenAI 兼容 embedding 服务。
# 维度必须 1024（bge-m3），否则与 knowledge_chunks.embedding 不匹配。
# 不配置或不可达时，对话功能不受影响，但上传/粘贴文档会失败。
# EMBEDDING_BASE_URL=http://ollama:11434/v1
# EMBEDDING_MODEL_NAME=bge-m3
# EMBEDDING_API_KEY=local
# EMBEDDING_BATCH_SIZE=16

# ---------- 访问鉴权（账号密码体系，无需手动配置 token） ----------
# 用户注册/登录即可使用，数据按账号自动隔离。
# AUTH_SECRET 用于签名登录令牌；不设置则首次启动自动生成并持久化到 data/auth_secret，
# 容器重启后令牌依然有效。生产环境建议固定一个随机值（可选）：
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# ---------- CORS（前后端同源反代，通常留空即可） ----------
# 前后端同源（都走 nginx 80 端口）时无需配置；留空=用代码默认值。
# 若前端单独域名/端口，填 JSON 数组：CORS_ORIGINS=["https://你的域名"]

# ---------- 结构化日志与 Langfuse 可观测（可选，留空=关闭） ----------
# 日志为单行 JSON，每条带 request_id；页面报错显示的「问题编号」就是这个 id，
# 可用 docker compose logs backend | grep '<request_id>' 捞完整链路。
LOG_LEVEL=INFO
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# 三个凭证全部留空 = 追踪整体关闭、零网络请求、主流程不受影响。
# 一旦配置，trace（含模型输入输出）会发到 LANGFUSE_HOST，请先确认隐私边界。
# 关联规则：request_id 即 trace_id，同会话用 langfuse_session_id（= thread_id）归组。

# ---------- 其他（一般不用改） ----------
MAX_STEPS=8
MAX_TOKENS=20000
