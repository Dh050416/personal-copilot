# ============ PersonalCopilot 生产环境配置模板 ============
# 用法：cp .env.production .env ，填好下面带【必填】的项，然后 docker compose up -d --build

# ---------- 模型（云端 DeepSeek） ----------
# 【必填】你的 DeepSeek API Key（从本地 backend/.env 抄过来，别发到群里）
MODEL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash
# 云端模型会收到账单数据，必须显式打开
ALLOW_CLOUD_MODEL=true

# ---------- 访问鉴权（账号密码体系，无需手动配置 token） ----------
# 用户注册/登录即可使用，数据按账号自动隔离。
# AUTH_SECRET 用于签名登录令牌；不设置则首次启动自动生成并持久化到 data/auth_secret，
# 容器重启后令牌依然有效。生产环境建议固定一个随机值（可选）：
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# ---------- CORS（前后端同源反代，通常留空即可） ----------
# 前后端同源（都走 nginx 80 端口）时无需配置；留空=不额外校验。
# CORS_ORIGINS=["https://你的域名"]

# ---------- Langfuse 可观测（可选，留空=关闭） ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---------- 其他（一般不用改） ----------
MAX_STEPS=8
MAX_TOKENS=20000
